[Unit]
Description=Weekly Evanovation Restic maintenance for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=evanovation-db
Group=evanovation-db
Environment=PYTHONPATH=/opt/evanovation-db/current/src
ExecStart=/usr/bin/python3 -m evanovation_db.cli --config /etc/evanovation-db maintain forget %i --apply
ExecStart=/usr/bin/python3 -m evanovation_db.cli --config /etc/evanovation-db maintain check %i
TimeoutStartSec=24h
Nice=15
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/evanovation-db
