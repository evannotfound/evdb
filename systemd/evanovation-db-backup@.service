[Unit]
Description=Evanovation database backup for %i
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=evanovation-db
Group=evanovation-db
SupplementaryGroups=docker
Environment=PYTHONPATH=/opt/evanovation-db/current/src
EnvironmentFile=/etc/evanovation-db/jobs/%i
ExecStart=/usr/bin/python3 -m evanovation_db.cli --config /etc/evanovation-db backup ${GROUP} ${NAME}
TimeoutStartSec=6h
Nice=10
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/evanovation-db
