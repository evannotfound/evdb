[Unit]
Description=Check evdb backup repositories
After=network-online.target

[Service]
Type=oneshot
User=evdb
Group=evdb
ExecStart=/usr/local/bin/evdb backup repository-check --all --rotate
TimeoutStartSec=24h
Nice=19
IOSchedulingClass=idle
CPUWeight=5
IOWeight=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/evdb
