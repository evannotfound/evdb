[Unit]
Description=Back up evdb database %I
After=docker.service network-online.target

[Service]
Type=oneshot
User=evdb
Group=evdb
ExecStart=/usr/local/bin/evdb backup create %I --yes
TimeoutStartSec=6h
Nice=10
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/evdb
