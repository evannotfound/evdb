[Unit]
Description=Run the due evdb backup test
After=docker.service

[Service]
Type=oneshot
User=evdb
Group=evdb
ExecStart=/usr/local/bin/evdb backup test --due --yes
TimeoutStartSec=8h
Nice=15
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/evdb
