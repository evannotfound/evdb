[Unit]
Description=Check evdb host status
After=docker.service

[Service]
Type=oneshot
User=evdb
Group=evdb
ExecStart=/usr/local/bin/evdb status
TimeoutStartSec=15m
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/evdb
